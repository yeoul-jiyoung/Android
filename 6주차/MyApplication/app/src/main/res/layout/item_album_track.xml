<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/locker_track_more_img"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/btn_player_more"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageView
        android:id="@+id/locker_track_play_img"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/btn_player_play"
        app:layout_constraintEnd_toStartOf="@id/locker_track_more_img"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginEnd="8dp"/>

    <TextView
        android:id="@+id/item_album_track_title_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="LILAC"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/locker_track_play_img"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="8dp"/>

    <TextView
        android:id="@+id/item_album_track_singer_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="아이유 (IU)"
        android:textSize="13sp"
        android:textColor="@color/lightgray2"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="@id/item_album_track_title_tv"
        app:layout_constraintTop_toBottomOf="@id/item_album_track_title_tv"
        android:layout_marginStart="10dp"
        android:layout_marginTop="2dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
